doctype html 
html(lang="es")
    head 
        meta(charset="UTF-8")
        title Admin
        link(rel="stylesheet", href="/css/style.css")
    body 
        //- Este menu aparecera en todas las paginas automaticamente
        nav 
            
            form(action="/api/orders" method="GET" style="display: inline;")
                button(type="submit") Orders
            
            form(action="/api/products" method="GET" style="display: inline;")
                button(type="submit") Products
            //- Formulario para cerrar sesion
            form(action="/auth/logout" method="POST" style="display: inline;")
                button(type="submit") Logout

        div.container 
            //- Aca es donde se pondra cada contenido de cada pagina
            block content